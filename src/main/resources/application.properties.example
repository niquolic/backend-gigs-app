# Copy this file to application.properties for local development, or use environment variables.
# Never commit real credentials or production secrets.
spring.mongodb.uri=${MONGODB_URI}
spring.mongodb.database=${MONGODB_DATABASE:GigsAppDB}

# In-memory statistics cache (30-minute safety expiration).
spring.cache.type=caffeine
spring.cache.caffeine.spec=maximumSize=10000,expireAfterWrite=30m

# Use a cryptographically random secret of at least 32 bytes, stored in a secret manager.
jwt.secret=${JWT_SECRET}
# 15 minutes by default; review the token/session strategy before changing this.
jwt.expirationMs=${JWT_EXPIRATION_MS:900000}

logging.level.root=INFO
logging.level.com.example.backendgigsapp=INFO
