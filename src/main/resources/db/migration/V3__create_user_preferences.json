{
  "create": "user_preferences",
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "required": ["userId", "language", "currency"],
      "properties": {
        "userId": {
          "bsonType": "objectId",
          "description": "Reference to the user in the users collection"
        },
        "language": {
          "bsonType": "string",
          "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
          "description": "Language code, for example fr, en, es or fr-FR"
        },
        "currency": {
          "bsonType": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "Three-letter currency code, for example EUR or USD"
        }
      }
    }
  },
  "validationLevel": "strict",
  "validationAction": "error"
}
